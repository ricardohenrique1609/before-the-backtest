  "rules_module": "scripts/h20_1_rep.py (h20_1_rep_v1), unchanged; its sha256 must equal H20_1_REPRESENTATION_FREEZE.json",
  "computed_at": "every landmark decision time t = w + 1 d 00:00 UTC (not the H20.1 monthly sample); common to all assets at t",
  "sources_to_extend": "Federal Register and SEC months already collected cover every W30 window; the Fed feed bytes are reused; ALFRED vintages and Wikipedia day-page revisions are collected for each new t with the H20.1 collector logic",
  "missing": "as H20.1 (NaN + reason, never 0); in models: train-median imputation + missing indicator (logistic), native NaN (trees)",
  "c3_scope": "the only C3 feature is generic English-Wikipedia crypto attention (count of crypto items in current-events day pages). It is NOT a systemic-crypto-state representation; no stress, failure or depeg feature survived H20.1",
  "excluded": "all GDELT features (F19-F22), CFTC (F17), F24 (redundant), F25 (stress, degenerate), any C4/C5, any LLM or embedding feature, any repaired representation",
  "classifier_dependence": {
   "c1_fomc_statement_flag_W7": "K3",
   "c2_fedreg_crypto_doc_count_W7": "K1b",
   "c2_fedreg_crypto_doc_count_W30": "K1b",
