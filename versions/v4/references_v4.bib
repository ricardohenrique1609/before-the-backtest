@article{bailey2014deflated,
  author  = {Bailey, David H. and L{\'o}pez de Prado, Marcos},
  title   = {The Deflated Sharpe Ratio: Correcting for Selection Bias, Backtest Overfitting
             and Non-Normality},
  journal = {The Journal of Portfolio Management},
  volume  = {40},
  number  = {5},
  pages   = {94--107},
  year    = {2014},
  note    = {Accessed at abstract and SSRN-record level (SSRN 2460551). Corrects a reported Sharpe
             ratio for the number of trials, skewness and kurtosis. Establishes that the count of
             strategy variants tried is a required input to any performance claim. Cited here as
             prior work that already owns the "a spectacular backtest is a candidate artefact"
             message at the model-selection layer.}
}

@article{kapoor2023leakage,
  author  = {Kapoor, Sayash and Narayanan, Arvind},
  title   = {Leakage and the reproducibility crisis in machine-learning-based science},
  journal = {Patterns},
  volume  = {4},
  number  = {9},
  pages   = {100804},
  year    = {2023},
  doi     = {10.1016/j.patter.2023.100804},
  note    = {Accessed at abstract and project-page level; the three top-level taxonomy categories
             were read from the authors' project page, the full eight-type taxonomy was not.
             Surveys 17 fields and 294 affected papers in the published version (329 in the 2022
             arXiv preprint, arXiv:2207.07048). Its second top-level category, "model uses features
             which are not legitimate", plausibly already covers the classification-level leakage
             this manuscript measures; the manuscript therefore claims a detection procedure and a
             measured rate, not a new category.}
}

@article{menkveld2024nonstandard,
  author  = {Menkveld, Albert J. and others},
  title   = {Nonstandard Errors},
  journal = {The Journal of Finance},
  volume  = {79},
  number  = {3},
  pages   = {2339--2390},
  year    = {2024},
  doi     = {10.1111/jofi.13337},
  note    = {Accessed at metadata and repository-record level. Multi-team design: many independent
             research teams are given the same data and the same hypothesis, and the dispersion of
             their results is measured. Open access under CC BY. The full author list is very long
             and is abbreviated here as "and others" rather than guessed. Cited as the prior work
             that owns researcher-discretion variation; its object is dispersion across analysis
             choices on a shared dataset, which is downstream of the dataset-construction failures
             this manuscript documents.}
}

@misc{jbef_registered_reports,
  title        = {Registered Reports: Author Guidelines},
  howpublished = {Journal of Behavioral and Experimental Finance},
