@article{shumway1997delisting,
  author  = {Shumway, Tyler},
  title   = {The Delisting Bias in {CRSP} Data},
  journal = {The Journal of Finance},
  volume  = {52},
  number  = {1},
  pages   = {327--340},
  year    = {1997},
  note    = {Accessed at abstract and RePEc-record level. Documents that correct delisting returns
             are missing for most stocks delisted for negative reasons, so studies that drop
             delisted firms overstate average returns. The canonical statement of the survivorship
             problem this manuscript meets again in a different data environment.}
}

@article{shumway1999nasdaq,
  author  = {Shumway, Tyler and Warther, Vincent A.},
  title   = {The Delisting Bias in {CRSP}'s {Nasdaq} Data and its Implications for the Size Effect},
  journal = {The Journal of Finance},
  volume  = {54},
  number  = {6},
  pages   = {2361--2379},
  year    = {1999},
  note    = {Accessed at abstract, RePEc-record and secondary-summary level. Estimates a $-55\%$
             correction for performance-related Nasdaq delistings and reports that the Nasdaq size
             effect does not survive it. Cited as the strongest precedent for the claim that a
             construction choice in a database can carry a published result.}
}

@article{hou2020replicating,
  author  = {Hou, Kewei and Xue, Chen and Zhang, Lu},
  title   = {Replicating Anomalies},
  journal = {The Review of Financial Studies},
  volume  = {33},
  number  = {5},
  pages   = {2019--2133},
  year    = {2020},
  doi     = {10.1093/rfs/hhy131},
  note    = {Accessed at abstract, RePEc-record and NBER working-paper level (NBER w23394, 2017).
             Compiles 447 anomaly variables and reports 286 (64\%) insignificant at the 5\% level
             under NYSE breakpoints and value weighting. The published author list should be
             checked against the journal page: the NBER published-version citation lists an
             additional co-author that the RePEc record omits, and that discrepancy is recorded
             here rather than resolved by assumption.}
}

