@article{petersen2012positivity,
  author  = {Petersen, Maya L. and Porter, Kristin E. and Gruber, Susan and Wang, Yue
             and van der Laan, Mark J.},
  title   = {Diagnosing and responding to violations in the positivity assumption},
  journal = {Statistical Methods in Medical Research},
  volume  = {21},
  number  = {1},
  pages   = {31--54},
  year    = {2012},
  note    = {Accessed at abstract and secondary-reference level; first published online 28 October
             2010. The volume and page numbers come from a secondary reference list and were not
             confirmed on the publisher's own record, which is recorded here rather than presented
             as verified. Covers positivity violations where subgroups rarely or never receive a
             treatment of interest, a parametric-bootstrap diagnostic, and responses including
             restricting the adjustment set, restricting the sample, or modifying the target
             intervention. Cited as the prior work that owns the common-support problem; this
             manuscript's claim is procedural - bounding feasibility on the full eligible pool
             before a design is frozen and before any outcome is opened.}
}

