% ACCESS RULE: every entry states its access level. "abstract or metadata level" means the full
% text was not read and nothing in the manuscript implies otherwise.

% =====================================================================================
% (0) DESIGN-STAGE / OUTCOME-FREE DESIGN
% The literature this paper's contribution is positioned against. Rubin (2008) states the
% design-stage rejection principle directly; nothing in this paper claims it.
% =====================================================================================

@article{rubin2008design,
  author  = {Rubin, Donald B.},
  title   = {For objective causal inference, design trumps analysis},
  journal = {The Annals of Applied Statistics},
  volume  = {2},
  number  = {3},
  year    = {2008},
  doi     = {10.1214/08-AOAS187},
  note    = {Accessed at abstract, arXiv (0811.1640) and Project Euclid record level; the full text
             was not read. States that observational studies must be designed without examining any
             outcome data, and that a candidate dataset may have to be rejected as inadequate for
             lack of covariate data or lack of overlap between treatment and control groups, often
             revealed by propensity-score analysis. **This is the design-stage rejection principle
             that this paper operationalises; the principle is Rubin's and is not claimed here.**
             Page numbers were not recorded by the source consulted and are not supplied.}
}

@article{li2023propensity,
  author  = {Li},
  title   = {Propensity score-based methods for causal inference and external data leveraging in
             regulatory settings: From basic ideas to implementation},
  journal = {Pharmaceutical Statistics},
  year    = {2023},
  doi     = {10.1002/pst.2294},
  note    = {Accessed at abstract and publisher-record level. Describes the Rubin outcome-free study
             design principle and a two-stage outcome-free propensity-score design framework
             developed for medical-device studies to safeguard study integrity and objectivity.
             Cited as prior codification of the outcome-free design stage. Given name, volume, issue
             and pages were not recorded by the source consulted and are not supplied.}
}

@article{psweight,
  title   = {PSweight: An {R} Package for Propensity Score Weighting Analysis},
  journal = {The R Journal},
  note    = {Accessed at journal-article and arXiv (2010.08893) record level; article identifier
             RJ-2022-011. Its design module visualises overlap - the positivity assumption - and
             evaluates covariate balance prior to the use of outcome data, and supports symmetric
             trimming when overlap is limited. Cited as an existing implementation of design-stage
             overlap diagnostics run before outcome access. Authors and year were not recorded by
             the source consulted and are not supplied.}
}

